#Snippets for all files.

priority -1

#Auto pair delimiters
snippet ' "single quotation marks" A
'${1:${VISUAL:}}'$0
endsnippet

snippet ( "Paired parentheses ()" iA
(${1:${VISUAL:}})$0
endsnippet

snippet [ "Paired square brackets []" iA
[${1:${VISUAL:}}]$0
endsnippet

snippet { "Paired curly brackets {}" iA
{${1:${VISUAL:}}}$0
endsnippet

